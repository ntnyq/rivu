{
  "oxc.enable": true,
  "eslint.enable": false,
  "prettier.enable": false,
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.codeActionsOnSave": {
    "source.format.oxc": "explicit"
  },
  "[go]": {
    "editor.defaultFormatter": "golang.go"
  },
  "cSpell.words": [
    "anacrolix",
    "btih",
    "btstorage",
    "bumpp",
    "esbuild",
    "GOARCH",
    "godiff",
    "gofmt",
    "GOTOOLCHAIN",
    "libayatana",
    "lstrip",
    "missinggo",
    "mygo",
    "NSIS",
    "purego",
    "quiesces",
    "reprioritization",
    "Reprioritizing",
    "rivu",
    "shutil",
    "subn",
    "unconfigured",
    "unsubmitted",
    "Upverted",
    "vitepress"
  ]
}
